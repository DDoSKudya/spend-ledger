# --- Runtime ---
# development | test | production (production enforces JWT_SECRET length >= 32)
APP_ENV=development
# debug | info | warning | error
LOG_LEVEL=debug

# --- Auth database (auth-service) ---
POSTGRES_AUTH_USER=spend_auth
POSTGRES_AUTH_PASSWORD=change_me_auth
POSTGRES_AUTH_DB=auth_db
AUTH_DATABASE_URL=postgresql+asyncpg://spend_auth:change_me_auth@postgres-auth:5432/auth_db

# --- Ledger database (ledger-service) ---
POSTGRES_LEDGER_USER=spend_ledger
POSTGRES_LEDGER_PASSWORD=change_me_ledger
POSTGRES_LEDGER_DB=ledger_db
LEDGER_DATABASE_URL=postgresql+asyncpg://spend_ledger:change_me_ledger@postgres-ledger:5432/ledger_db

# --- JWT (shared by auth-service and bff) ---
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# --- Internal service URLs (Docker network hostnames) ---
AUTH_SERVICE_URL=http://auth-service:8001
LEDGER_SERVICE_URL=http://ledger-service:8002
EXPORT_SERVICE_URL=http://export-api:8003
# Set to false when running without the export compose profile
EXPORT_ENABLED=true

# --- Export (redis + Celery worker; requires --profile export) ---
REDIS_URL=redis://redis:6379/0
EXPORT_FILES_DIR=/data/exports

# --- Ledger debugging ---
# Log SQL statements to stdout
SQLALCHEMY_ECHO=true
# Log per-request duration in ledger middleware
PROFILE_REQUESTS=false
# Enable pyinstrument HTML profiling per request (ledger-service)
ENABLE_PYINSTRUMENT=false

# --- TLS (optional) ---
# Generate dev certs: ./scripts/generate-dev-certs.sh
# Then restart nginx to enable HTTPS on :443
# Production: mount real certs into infra/certs (fullchain.pem, privkey.pem)

# --- Frontend (optional, for local npm run dev) ---
# VITE_CURRENCY=USD

# --- Container ports (internal; not published to host by default) ---
BFF_PORT=8000
AUTH_PORT=8001
LEDGER_PORT=8002
EXPORT_PORT=8003
