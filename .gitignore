# OS
.DS_Store
Thumbs.db

# IDE / editors (local only — do not commit)
.idea/
.vscode/
.cursor/
*.code-workspace
*.swp
*.swo
*~

# Pyright/Basedpyright project configs (pyrightconfig.json) are committed on purpose.

# Environment (repo root and per-service)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (root .venv + services/*)
.venv/
venv/
__pycache__/
*.py[cod]
.Python
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.uv/

# Node / frontend
node_modules/
dist/
frontend/dist/
frontend/coverage/
frontend/.vite/
**/.vite/
frontend/.eslintcache
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Build & cache (other tools)
build/
out/
target/
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/

# Test & coverage (repo root from make test)
coverage/

# Database
*.db
*.sqlite
*.sqlite3

# Infra — generated TLS certs (see scripts/generate-dev-certs.sh)
infra/certs/*
!infra/certs/.gitkeep

# Local planning notes
.plan
